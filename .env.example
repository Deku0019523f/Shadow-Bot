# ── Identité ─────────────────────────────
BOT_NAME="Shadow Bot"
PREFIX=.
# Votre numéro d'hébergeur (format international sans +), séparés par des virgules si plusieurs.
# Seul ce numéro peut utiliser les commandes serveur (restart, update, plugin...).
# Chaque utilisateur reste propriétaire de SON bot sans rien configurer ici.
OWNER=2250700000000
# Nombre maximum de comptes WhatsApp reliés en même temps (chaque compte consomme ~60-100 Mo de mémoire)
MAX_SESSIONS=10
MODE=public            # public (ouvert à tous, par défaut) | private

# ── Page web de connexion ────────────────
PORT=3000
# Mot de passe de la section « Administration » de la page (si vide : généré et affiché dans les logs)
WEB_PASSWORD=
PUBLIC_URL=

# ── Stockage ─────────────────────────────
# Vide = SQLite local (VPS / Docker avec volume sur ./data)
# Renseigné = PostgreSQL (obligatoire sur Render/Railway/Koyeb... disque éphémère)
DATABASE_URL=

# ── API HTTP (optionnelle, active si API_KEY défini) ──
API_KEY=
API_WEBHOOK_URL=

# ── Clés API (AUCUNE n'est obligatoire) ──
# Chaque utilisateur configure uniquement ce qu'il veut utiliser, directement depuis WhatsApp :
#   .setvar GEMINI_API_KEY = votre_clé
# Clés reconnues : OPENAI_API_KEY, GEMINI_API_KEY, GROQ_API_KEY, OPENROUTER_API_KEY (commandes IA),
# OPENWEATHER_API_KEY, NEWS_API_KEY, OMDB_API_KEY, REMOVEBG_API_KEY, GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET.
# Sans clé, les commandes concernées expliquent comment la renseigner ; le reste du bot fonctionne.

# ── Réglages divers (optionnels) ───────────
TZ=Africa/Abidjan              # fuseau des rappels / messages programmés
LANG_CODE=fr                   # langue par défaut de tts / trt / actualités
NEWS_COUNTRY=CI                # pays des actualités (code ISO)
WCG_LANG=fr                    # langue du dictionnaire des jeux de mots
WARN_LIMIT=3                   # avertissements avant expulsion (modifiable : setvar WARN_LIMIT = 5)
MAX_DOWNLOAD_MB=90             # taille max des téléchargements yt-dlp
# Modèles IA (valeurs par défaut si vide)
AI_PROVIDER=                   # openai | groq | openrouter | gemini (chatbot lydia)
AI_SYSTEM_MSG=
OPENAI_MODEL=
OPENAI_IMAGE_MODEL=
GEMINI_MODEL=
GEMINI_IMAGE_MODEL=
GROQ_MODEL=
OPENROUTER_MODEL=
