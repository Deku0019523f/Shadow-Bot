# ── Identité ─────────────────────────────
BOT_NAME="Shadow Bot"
PREFIX=.
# Numéros propriétaires (format international sans +), séparés par des virgules
OWNER=2250700000000
MODE=public            # public | private

# ── Page web de connexion ────────────────
PORT=3000
# Mot de passe de la page web (si vide : généré et affiché dans les logs au 1er démarrage)
WEB_PASSWORD=change-me
PUBLIC_URL=

# ── Stockage ─────────────────────────────
# Vide = SQLite local (VPS / Docker avec volume sur ./data)
# Renseigné = PostgreSQL (obligatoire sur Render/Railway/Koyeb... disque éphémère)
DATABASE_URL=

# ── Connexion automatique par code (optionnel) ──
# Sinon : tout se fait depuis la page web (QR code ou code de jumelage)
PAIRING_NUMBER=

# ── API HTTP (optionnelle, active si API_KEY défini) ──
API_KEY=
API_WEBHOOK_URL=

# ── Services externes (optionnels) ───────
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENWEATHER_API_KEY=
NEWS_API_KEY=
OMDB_API_KEY=
REMOVEBG_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Réglages divers (optionnels) ─────────
TZ=Africa/Abidjan              # fuseau des rappels / messages programmés
LANG_CODE=fr                   # langue par défaut de tts / trt / actualités
NEWS_COUNTRY=CI                # pays des actualités (code ISO)
WCG_LANG=fr                    # langue du dictionnaire des jeux de mots
WARN_LIMIT=3                   # avertissements avant expulsion (modifiable : setvar WARN_LIMIT = 5)
MAX_DOWNLOAD_MB=90             # taille max des téléchargements yt-dlp
# Modèles IA (valeurs par défaut si vide)
AI_PROVIDER=                   # openai | groq | openrouter | gemini (chatbot lydia)
AI_SYSTEM_MSG=
OPENAI_MODEL=
OPENAI_IMAGE_MODEL=
GEMINI_MODEL=
GEMINI_IMAGE_MODEL=
GROQ_MODEL=
OPENROUTER_MODEL=
